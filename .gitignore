# Generated geometry. The script that makes it is the source of truth.
out/

# Your own images, scans and drawings. Shipped examples live in samples/.
inputs/

# Your printer captures: each describes one printer and its loaded spools, so
# none ships. profiles/README.md says how to make yours.
profiles/*
!profiles/README.md

# Where the Claude desktop app drops delivered files.
Claude outputs/

__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
.DS_Store

# .claude/ is local by default: settings, memory and worktrees stay on this
# machine. Only skills listed here are tracked, one folder per skill, so a new
# file dropped under .claude/ is never published by accident.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/fix-downloaded-3mf/
